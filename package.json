{
  "name": "mpv-web",
  "version": "1.0.0",
  "private": true,
  "description": "An mpv-style minimal, keyboard-driven player front-end for Spotify and YouTube",
  "author": "MAVERICKx1902",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "desktop": "electron .",
    "build:win": "electron-builder --win nsis portable",
    "build:win:dir": "electron-builder --win dir"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.maverickx1902.mpvweb",
    "productName": "mpv-web",
    "files": [
      "server.js",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "mpv-web-portable.exe"
    }
  }
}
