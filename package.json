{
  "name": "secret-santa",
  "version": "1.0.0",
  "private": true,
  "description": "Secret Santa organizer — draw names locally, reveal assignments privately",
  "author": "MAVERICKx1902",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "desktop": "electron .",
    "build:win": "electron-builder --win nsis portable",
    "build:win:dir": "electron-builder --win dir"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.22.2"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.maverickx1902.secretsanta",
    "productName": "Secret Santa",
    "files": [
      "index.html",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "portable": {
      "artifactName": "SecretSanta-portable.exe"
    }
  }
}
